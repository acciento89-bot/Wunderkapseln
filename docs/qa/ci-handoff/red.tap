      'set -euo pipefail\n' +
      `version="$(xcodebuild -version | awk '/Xcode/{print $2}')"\n` +
      `python3 - "$version" <<'PY'\n` +
      'import sys\n' +
      "parts = tuple(int(x) for x in sys.argv[1].split('.')[:2])\n" +
      'if parts < (26, 2):\n' +
      "    raise SystemExit(f'Xcode 26.2+ required, found {sys.argv[1]}')\n" +
      'PY\n' +
      '\n' +
      'npx --no-install expo prebuild --platform ios --no-install\n' +
      'pod install\n' +
      'set -euo pipefail\n' +
      `workspace="$(find ios -maxdepth 1 -name '*.xcworkspace' -type d | head -n 1)"\n` +
      `project="$(find ios -maxdepth 1 -name '*.xcodeproj' -type d | head -n 1)"\n` +
      'test -n "$workspace"\n' +
      'test -n "$project"\n' +
      'scheme="$(basename "$project" .xcodeproj)"\n' +
      'xcodebuild \\\n' +
      '  -workspace "$workspace" \\\n' +
      '  -scheme "$scheme" \\\n' +
      '  -configuration Release \\\n' +
      '  -sdk iphonesimulator \\\n' +
      '  -derivedDataPath dist/ios-derived \\\n' +
      '  CODE_SIGNING_ALLOWED=NO \\\n' +
      '  CODE_SIGNING_REQUIRED=NO \\\n' +
      '  build\n' +
      '\n' +
      'set -euo pipefail\n' +
      'mkdir -p dist/build-evidence\n' +
      "mapfile -t apps < <(find dist/ios-derived/Build/Products/Release-iphonesimulator -maxdepth 1 -name '*.app' -type d)\n" +
      'test "${#apps[@]}" -eq 1\n' +
      'app="${apps[0]}"\n' +
      'python3 tools/audit-native.py --ios "$app/Info.plist" > dist/build-evidence/ios-simulator-capabilities.json\n' +
      `/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Info.plist" | grep -Fx 'com.kamilunavo.wondercaps'\n` +
      'ditto -c -k --sequesterRsrc --keepParent "$app" dist/WonderCaps-iOS-Simulator.zip\n' +
      'shasum -a 256 dist/WonderCaps-iOS-Simulator.zip > dist/build-evidence/ios-simulator.sha256\n' +
      '\n'
    
  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    
    
    
    npm run native:install
    npm run assets
    set -euo pipefail
    version="$(xcodebuild -version | awk '/Xcode/{print $2}')"
    python3 - "$version" <<'PY'
    import sys
    parts = tuple(int(x) for x in sys.argv[1].split('.')[:2])
    if parts < (26, 2):
        raise SystemExit(f'Xcode 26.2+ required, found {sys.argv[1]}')
    PY
    
    npx --no-install expo prebuild --platform ios --no-install
    pod install
    set -euo pipefail
    workspace="$(find ios -maxdepth 1 -name '*.xcworkspace' -type d | head -n 1)"
    project="$(find ios -maxdepth 1 -name '*.xcodeproj' -type d | head -n 1)"
    test -n "$workspace"
    test -n "$project"
    scheme="$(basename "$project" .xcodeproj)"
    xcodebuild \
      -workspace "$workspace" \
      -scheme "$scheme" \
      -configuration Release \
      -sdk iphonesimulator \
      -derivedDataPath dist/ios-derived \
      CODE_SIGNING_ALLOWED=NO \
      CODE_SIGNING_REQUIRED=NO \
      build
    
    set -euo pipefail
    mkdir -p dist/build-evidence
    mapfile -t apps < <(find dist/ios-derived/Build/Products/Release-iphonesimulator -maxdepth 1 -name '*.app' -type d)
    test "${#apps[@]}" -eq 1
    app="${apps[0]}"
    python3 tools/audit-native.py --ios "$app/Info.plist" > dist/build-evidence/ios-simulator-capabilities.json
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Info.plist" | grep -Fx 'com.kamilunavo.wondercaps'
    ditto -c -k --sequesterRsrc --keepParent "$app" dist/WonderCaps-iOS-Simulator.zip
